# ===========================================
# CONFIGURATION PRODUCTION - IMMODASH
# ===========================================
# Copier ce fichier en .env.production et remplir avec vos valeurs

# Django
DEBUG=False
SECRET_KEY=GENERER_UNE_CLE_SECRETE_LONGUE_ET_ALEATOIRE_ICI
ALLOWED_HOSTS=votre-domaine.com,www.votre-domaine.com
CSRF_TRUSTED_ORIGINS=https://votre-domaine.com,https://www.votre-domaine.com

# Base de données PostgreSQL
POSTGRES_DB=immodash
POSTGRES_USER=immodash
POSTGRES_PASSWORD=GENERER_UN_MOT_DE_PASSE_FORT_ICI

# Redis
REDIS_PASSWORD=GENERER_UN_MOT_DE_PASSE_FORT_ICI

# Email (optionnel - pour les notifications)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=votre-email@gmail.com
# EMAIL_HOST_PASSWORD=votre-mot-de-passe-app

# Sentry (optionnel - pour le monitoring d'erreurs)
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# ===========================================
# COMMANDES UTILES POUR GÉNÉRER DES SECRETS
# ===========================================
#
# Générer SECRET_KEY:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
#
# Générer mot de passe aléatoire:
#   openssl rand -base64 32
#
